# ─── Backend (Spring Boot) ─────────────────────────────────────────────
# Copia este archivo a .env (o exporta las variables) para correr en local.
# En produccion (Railway) se configuran como variables de entorno del servicio.

# Base de datos (dev: docker-compose Postgres; prod: Railway Postgres)
DB_URL=jdbc:postgresql://localhost:5433/sinapsistencia
DB_USER=sinapsistencia
DB_PASSWORD=sinapsistencia

# JWT (usa un secreto largo y aleatorio en base64 para produccion)
JWT_SECRET=change-me-in-prod-use-a-long-random-base64-secret-value-please
JWT_EXPIRATION=86400000

# Servicio ML (FastAPI) — dev local / URL de Railway en prod
ML_SERVICE_URL=http://localhost:8000

# n8n webhook base (fire-and-forget): alertas de riesgo + correos transaccionales.
# El backend concatena los paths /webhook/risk-alert y /webhook/sinapsistencia-mail.
# En prod usa la URL de tu instancia de n8n (Railway/n8n Cloud). Si queda vacio,
# los correos se omiten y forgot-password devuelve el token en la respuesta (fallback dev).
N8N_WEBHOOK_URL=http://localhost:5678

# URL publica del frontend — usada para armar los enlaces dentro de los correos
# (ej. el enlace de restablecer contrasena). En prod = dominio de Vercel.
APP_FRONTEND_URL=http://localhost:4200

# Cloudinary (storage de avatares + documentos de soporte)
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# CORS: dominio del frontend (dev Angular / dominio de Vercel en prod)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Docker Compose auto-start (solo dev local — en Railway NO poner esta variable)
SPRING_DOCKER_COMPOSE_ENABLED=true

# Correos de las cuentas demo (Dr. Carlos / Dra. Lucia). Solo en prod, para que
# los correos de la demostracion lleguen a una bandeja real (ej. alias + de Gmail).
# Si no se definen, se usan los correos ficticios del seed.
DEMO_DOCTOR_EMAIL=tucorreo+carlos@gmail.com
DEMO_LAWYER_EMAIL=tucorreo+lucia@gmail.com
